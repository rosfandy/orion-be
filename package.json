{
  "name": "orion-be",
  "version": "1.0.0",
  "private": true,
  "description": "Express.js API built with TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "prisma generate --schema prisma && tsc -p tsconfig.json",
    "start": "node dist/dev.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate --schema prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma",
    "prisma:studio": "prisma studio --schema prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "google-auth-library": "^10.2.0",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.117",
    "neo4j-driver": "^6.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.20.2",
    "@types/pino-http": "^5.8.4",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.0"
  }
}
